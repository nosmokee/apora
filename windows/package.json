{
  "name": "opora",
  "version": "1.0.0",
  "description": "Офлайн-учебная полка: формулы и задания",
  "main": "app/main.cjs",
  "scripts": {
    "build:win": "electron-builder --win portable --x64",
    "test:smoke": "electron tests/smoke.cjs"
  },
  "keywords": [],
  "author": "NoSmoke",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ru.opora.study",
    "productName": "Opora",
    "asar": true,
    "files": [
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "electronVersion": "45.0.0",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "artifactName": "Opora-1.0.0-Windows-x64.exe",
      "icon": "app/icon.ico"
    },
    "portable": {
      "artifactName": "Opora-1.0.0-Windows-x64.exe",
      "requestExecutionLevel": "user"
    },
    "compression": "normal"
  },
  "private": true
}
